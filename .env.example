# =============================================================================
# Swosh Workspace environment variables
# Copy to .env.local and fill in. Never commit real values.
# The app builds without these (clients are created lazily), but every feature
# that needs a variable fails with a clear server-side error until it is set.
# =============================================================================

# ---- NextAuth ---------------------------------------------------------------
# Public base URL of the app (used for auth callbacks and share links).
NEXTAUTH_URL=http://localhost:3000
# Long random string (>= 32 chars), e.g. `openssl rand -base64 48`.
# REQUIRED: also signs direct-upload tokens; there is no fallback.
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# ---- Supabase -----------------------------------------------------------------
# Server-side URL (falls back to NEXT_PUBLIC_SUPABASE_URL when unset).
SUPABASE_URL=https://your-project.supabase.co
# Browser-side URL + anon key: used ONLY for Realtime (private channels). All table
# access is server-side; RLS + revoked grants make the anon key useless for data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key: server only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Legacy JWT secret (Dashboard -> Project Settings -> API / JWT Keys -> "Legacy JWT
# secret"). Signs the 1-hour realtime tokens from /api/chat/realtime-token.
# If unset, the endpoint returns 503 "realtime_unconfigured" and chat falls back to polling.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ---- Object storage (S3-compatible bucket) ------------------------------------
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Optional: override the endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com).
# R2_ENDPOINT=
#
# Direct (presigned) uploads go from the browser straight to the bucket, so the
# bucket needs a CORS policy allowing PUT from the app origin. Bucket -> Settings ->
# CORS policy (replace the origins):
# [
#   {
#     "AllowedOrigins": ["http://localhost:3000", "https://your-app.example.com"],
#     "AllowedMethods": ["PUT"],
#     "AllowedHeaders": ["Content-Type"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3600
#   }
# ]
# The bucket must NOT have public access enabled; downloads are proxied by the app.
# NOTE: next.config.ts reads NEXT_PUBLIC_SUPABASE_URL and R2_ACCOUNT_ID/R2_ENDPOINT at
# BUILD time to build the Content-Security-Policy connect-src, so set them for builds too.

# ---- Mail (SMTP) ------------------------------------------------------------
# Sending account. For Gmail use a 16-character App Password (2-Step Verification on).
EMAIL_USER=your_smtp_email@gmail.com
EMAIL_PASS=your_smtp_app_password
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS, 587 = STARTTLS (try 587 if outbound 465 is blocked).
SMTP_PORT=465
# Default recipient when the "To" field is left empty (defaults to EMAIL_USER).
EMAIL_TO=
# Set to "true" to disable sending (POST /api/send returns 503 "maintenance").
MAIL_MAINTENANCE=false
